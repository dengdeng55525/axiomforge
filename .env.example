# Copy to .env (ignored by Git), set permissions to 600, insert your own key.
# Official DeepSeek V4.1 Flash API, verified 2026-09-28.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional FUTURE local endpoint. No local model is installed by this project.
# Use --provider local_http only after independently deploying it.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8100/v1
LOCAL_LLM_MODEL=coder_a
# Static plan for a future four RTX 4090D local deployment (no process starts here).
LOCAL_LLM_PROFILE=four_gpu_14b

# Optional when running outside an editable source checkout.
# ALGOFORGE_ROOT=/absolute/path/to/algorithm-capability-factory
