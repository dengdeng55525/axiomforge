# Copy to .env (ignored by Git), set permissions to 600, insert your own key.
# Official DeepSeek V4.1 Flash API, verified 2026-09-28.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# OpenAI Python SDK / Responses API. Change URL and key together for your gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
# SSE by default; false selects non-streaming Responses in this application.
OPENAI_STREAM=true
# Requested reasoning configuration; empty uses the model default. Actual usage is audited.
OPENAI_REASONING_EFFORT=none
# Optional per-command/application-process override; leave empty for direct connections.
# Pass OPENAI_PROXY_URL only to the command that needs a temporary HTTP(S) proxy.
# Ambient HTTP_PROXY / HTTPS_PROXY variables are ignored (trust_env=False).
OPENAI_PROXY_URL=

# Optional local vLLM OpenAI-compatible endpoint pool. Start four replicas with
# scripts/start_local_vllm.sh on a host with four RTX 4090D cards.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8100/v1
LOCAL_LLM_ENDPOINTS=http://127.0.0.1:8100/v1,http://127.0.0.1:8101/v1,http://127.0.0.1:8102/v1,http://127.0.0.1:8103/v1
LOCAL_LLM_MODEL=coder14
# Optional bearer token for a secured local OpenAI-compatible gateway.
LOCAL_LLM_API_KEY=
# Four RTX 4090D replicas, Qwen2.5-Coder-14B-Instruct-AWQ.
LOCAL_LLM_PROFILE=four_gpu_14b

# Optional when running outside an editable source checkout.
# ALGOFORGE_ROOT=/absolute/path/to/algorithm-capability-factory
