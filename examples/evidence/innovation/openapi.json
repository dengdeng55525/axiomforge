    "/graph/explore": {
      "get": {
        "summary": "Graph Explore",
        "description": "Bounded graph overview or neighborhood with auditable evidence.\n\nKinds and relations accept comma-separated exact values. Relationships\nconstrain traversal; kind/text filters constrain display, preserving an\nexisting focus node. The legacy unfiltered /graph endpoint is unchanged.",
        "operationId": "graph_explore_graph_explore_get",
        "parameters": [
          {
            "name": "focus",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ],
              "title": "Focus"
            }
          },
          {
            "name": "hops",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2,
              "minimum": 1,
              "default": 1,
              "title": "Hops"
            }
          },
          {
            "name": "kinds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512,
              "default": "",
              "title": "Kinds"
            }
          },
          {
            "name": "relations",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1024,
              "default": "",
              "title": "Relations"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "default": "",
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 120,
              "title": "Limit"
            }
          },
          {
            "name": "edge_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1500,
              "minimum": 0,
              "default": 300,
              "title": "Edge Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
