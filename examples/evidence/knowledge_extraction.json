  "capabilities": [
    {
      "capability_id": "extracted_bank_marketing_tabular_binary_classification",
      "name": "Bank marketing subscription propensity binary classification",
      "summary": "Predict whether a client subscribes to a term deposit (y=yes positive) from pre-contact customer attributes and prior campaign history, producing a propensity score and contact priority ranking.",
      "task_types": [
        "tabular_binary_classification"
      ],
      "inputs": [
        "age",
        "job",
        "marital",
        "education",
        "default",
        "housing",
        "loan",
        "pdays",
        "previous",
        "poutcome"
      ],
      "outputs": [
        "subscription propensity probability",
        "contact priority ranking"
      ],
      "preconditions": [
        "duration must be excluded as a business leakage field",
        "campaign excluded from main protocol",
        "contact/month/day_of_week excluded unless a planned-schedule protocol is defined",
        "economic indicators excluded from main protocol without point-in-time alignment",
        "unknown retained as a meaningful category",
        "pdays=999 treated as never-contacted, not imputed as extreme days",
        "derived features previously_contacted and days_since_previous fitted only on training data"
      ],
      "dependencies": [
        "scikit-learn"
      ],
      "source_ids": [
        "src-036a9125a071ef6a1ae3c21f",
        "src-9d912fa3bc826e2bfd7f1aff"
      ],
      "metrics": [
        "average_precision_score",
        "roc_auc_score"
      ]
    },
    {
      "capability_id": "extracted_sms_spam_text_binary_classification",
      "name": "SMS spam binary text classification",
      "summary": "Classify SMS messages as spam (positive) or ham using TF-IDF text features, with grouped splitting by normalized-text hash to control near-duplicates.",
      "task_types": [
        "text_binary_classification"
      ],
      "inputs": [
        "raw SMS text"
      ],
      "outputs": [
        "spam/ham label",
        "spam probability"
      ],
      "preconditions": [
        "UTF-8 read, split each line on first tab only",
        "grouping hash uses case-normalized and whitespace-collapsed text while model input keeps original text",
        "conflicting-label groups isolated for review",
        "one record per normalized group, stratified 60/20/20 split with seed=42",
        "vocabulary, IDF and tuning must not touch validation/test",
        "positive class is spam; all-ham predictions must not be reported as success"
      ],
      "dependencies": [
        "scikit-learn"
      ],
      "source_ids": [
        "src-df4abddd7280ca49a8328ee6"
      ],
      "metrics": [
        "average_precision_score",
        "roc_auc_score"
      ]
    },
